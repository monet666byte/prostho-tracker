# ก๊อปไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase (Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── สำรอง/กู้ข้อมูล (npm run backup · npm run restore) ───────────────────────
# บัญชีหัวหน้าภาค — ต้องเป็น "อาจารย์" ในตาราง app_users ไม่งั้นเห็นข้อมูลไม่ครบ
BACKUP_EMAIL=
BACKUP_PASSWORD=

# ── กู้/ย้ายไปเซิร์ฟเวอร์ "คนละตัว" (ซ้อมกู้ · ย้ายเข้าเซิร์ฟเวอร์ภาค) ────────
# ใส่สี่ค่านี้แล้ว npm run restore จะเขียนไปที่ปลายทางใหม่ ไม่แตะตัวจริง
# RESTORE_URL=
# RESTORE_ANON_KEY=
# RESTORE_EMAIL=
# RESTORE_PASSWORD=

# ⚠️ ห้ามใส่ SUPABASE_SERVICE_KEY เพื่อกู้ข้อมูล — trigger checkin_scoring_guard (0017)
#    เช็ค is_teacher() จาก auth.uid() ซึ่ง service key ไม่มี → คะแนนของทุกคาบหายเงียบๆ
#    (backup.ts รับ service key ได้ เพราะอ่านอย่างเดียว · restore.ts ปฏิเสธโดยเจตนา)
